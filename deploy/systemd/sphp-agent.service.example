[Unit]
Description=SPHP AI Agent
After=network.target sphp-java.service
Requires=sphp-java.service

[Service]
Type=simple
User=sphp
Group=sphp
WorkingDirectory=/opt/sphp/agent
EnvironmentFile=/opt/sphp/agent/.env
ExecStart=/opt/sphp/agent/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
