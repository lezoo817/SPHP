[Unit]
Description=SPHP Java Backend
After=network.target

[Service]
Type=simple
User=sphp
Group=sphp
WorkingDirectory=/opt/sphp/server
EnvironmentFile=/etc/sphp/java.env
ExecStart=/usr/bin/java -jar /opt/sphp/server/sphp-bootstrap.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
