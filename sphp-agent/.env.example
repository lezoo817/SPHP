# ---- 应用 ----
APP_NAME=智愈先锋 AI Agent 服务
DEBUG=True

# 无 token 时降级为匿名（仅开发环境设 true，生产必须 false）
ALLOW_ANONYMOUS=true

# ---- Agent 监听地址（python -m app.main 时生效） ----
AGENT_HOST=0.0.0.0
AGENT_PORT=8081

# ---- 后端服务地址 ----
# Java 统一后端（sphp-bootstrap）监听 8080，context-path=/api。
JAVA_BASE_URL=http://localhost:8080

# ---- LLM 供应商 ----
LLM_PROVIDER=zhipu

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 智谱 GLM ----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.6v
ZHIPU_EMBEDDING_MODEL=embedding-3

# ---- 通义千问 ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ---- Embedding 供应商（向量化） ----
# 可选: dashscope（阿里云百炼，默认）/ siliconflow / zhipu / openai
EMBEDDING_PROVIDER=dashscope

# 阿里云百炼 text-embedding-v4
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# 硅基流动 BAAI/bge-m3
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ---- LangSmith（可选） ----
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- PostgreSQL + pgvector（知识库向量存储） ----
PG_HOST=localhost
PG_PORT=5432
PG_USER=sphp
PG_PASSWORD=sphp123
PG_DATABASE=sphp

# ---- Redis（confirm_token / 限流 / confirm_done 回执） ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456

# 已确认操作回执 TTL（秒）：confirm 成功后下轮对话引用，默认 1 小时
CONFIRM_DONE_TTL=3600

# 会话 checkpointer 后端：memory（默认，进程内存）/ postgres（生产持久化，多 worker 共享会话）
# postgres 需安装 prod extra（langgraph-checkpoint-postgres）+ PG 就绪
CHECKPOINTER_BACKEND=memory

# ---- 知识库 ----
KB_COLLECTION=medical_knowledge
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_TOP_K=5
# 检索结果相关度阈值（0~1，低于该值不返回）
KB_MIN_SCORE=0.3
