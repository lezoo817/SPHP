# 生产环境 Agent 配置模板。复制为服务器上的私密 .env 后填入真实值，禁止提交 .env。
DEBUG=false
ALLOW_ANONYMOUS=false
AGENT_HOST=127.0.0.1
AGENT_PORT=8081
LOG_LEVEL=INFO

# 同机 Java 统一后端。
JAVA_BASE_URL=http://127.0.0.1:8080
# 仅填写实际 C/B 前端访问来源。
CORS_ORIGINS=["https://c.example.com","https://b.example.com"]

# 选择一个 LLM 供应商并配置其密钥。
LLM_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.6v

# 向量嵌入服务配置。
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# PostgreSQL 必须已安装 pgvector 扩展。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=sphp

# Redis 用于确认令牌、限流与确认回执。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 多进程生产部署使用 PostgreSQL 持久化会话。
CHECKPOINTER_BACKEND=postgres
CONFIRM_DONE_TTL=3600
RATE_LIMIT_PER_MINUTE=20
