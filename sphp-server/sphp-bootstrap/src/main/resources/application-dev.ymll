# 开发环境实际配置；application.yml 通过 ${dev.*} 占位符引用本文件中的值。
dev:
  server:
    port: 8080
    servlet:
      context-path: /api

  spring:
    application:
      name: sphp-bootstrap

    # ---- PostgreSQL ----
    datasource:
      driver-class-name: org.postgresql.Driver
      type: com.zaxxer.hikari.HikariDataSource
      username: postgres
      password: cG9zdGdyZXM=
      url: jdbc:postgresql://118.25.102.33:5432/sphp?client_encoding=UTF8
      hikari:
        connection-timeout: 5000
        idle-timeout: 600000
        max-lifetime: 1800000
        maximum-pool-size: 10
        minimum-idle: 5
        pool-name: SphpHikariPool

    # ---- Redis ----
    data:
      redis:
        host: 118.25.102.33
        port: 6379
        password: 123456
        database: 0
        timeout: 3000ms
        lettuce:
          pool:
            max-active: 20
            max-idle: 10
            min-idle: 5

    # ---- RabbitMQ ----
    rabbitmq:
      host: 118.25.102.33
      port: 5672
      username: admin
      password: 123456
      virtual-host: /
      connection-timeout: 1000ms
      dynamic: true
      listener:
        simple:
          auto-startup: true
          acknowledge-mode: auto
          concurrency: 5
          max-concurrency: 10
        direct:
          auto-startup: true

  # ---- MyBatis-Plus ----
  mybatis-plus:
    configuration:
      map-underscore-to-camel-case: true
      log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl
    global-config:
      db-config:
        logic-delete-field: deleted
        logic-delete-value: 1
        logic-not-delete-value: "null"

  # ---- Sa-Token（B端认证：签发 JWT，Bearer 头鉴权） ----
  sa-token:
    token-name: Authorization
    token-prefix: "Bearer"
    timeout: 7200
    is-concurrent: true
    is-share: false
    is-read-cookie: false
    is-read-header: true
    is-write-header: true
    jwt-secret-key: sphp-b-admin-jwt-secret-change-in-production
    is-log: false

  sphp:
    cors:
      # 允许访问统一后端的本地前端来源。
      allowed-origins:
        - http://localhost:8000
        - http://localhost:8001
    jwt:
      # C 端患者 Token 签名密钥。
      patient:
        secret: sphp-patient-jwt-secret-change-in-production
        expiration: 7200
      # B 端医生和管理员 Token 签名密钥。
      admin:
        secret: sphp-admin-jwt-secret-change-in-production
        expiration: 7200
    # 号源预扣超时，单位为秒。
    registration:
      payment-timeout: 900
      # C端可查询的未来放号天数，包含当天。
      slot-release-days: 7
      # 候补人收到可预约通知后的有效时间，单位秒。
      waitlist-notify-timeout: 900
      # 候补通知超时扫描间隔，单位毫秒。
      waitlist-scan-interval-millis: 60000
    # C端认证有效期与登录保护阈值。
    auth:
      captcha-expiration: 120
      login-max-failures: 5
      login-lock-seconds: 900
      refresh-token-expiration: 2592000
    # C端接口幂等成功结果与处理中占位的过期时间，单位为秒。
    idempotency:
      success-ttl-seconds: 86400
      processing-ttl-seconds: 30
    # C端用药与随访到期提醒扫描间隔，单位毫秒。
    notification:
      scan-interval-millis: 60000
    # C端模拟购药物流每次状态推进的延迟，单位秒。
    order:
      logistics:
        advance-interval-seconds: 30
    # C端药房推荐使用的模拟配送省市距离系数，不调用第三方地图服务。
    delivery:
      province-coefficients:
        beijing-guangdong: 3.5
        beijing-henan: 1.0
        beijing-jiangsu: 1.8
        beijing-shanghai: 2.1
        beijing-zhejiang: 2.3
        guangdong-henan: 2.8
        guangdong-jiangsu: 2.4
        guangdong-shanghai: 2.0
        guangdong-zhejiang: 1.7
        henan-jiangsu: 1.2
        henan-shanghai: 1.6
        henan-zhejiang: 1.8
        jiangsu-shanghai: 0.7
        jiangsu-zhejiang: 0.9
        shanghai-zhejiang: 0.6

# ---- 日志级别：日常关闭 MyBatis SQL 日志，调试时改为 DEBUG ----
logging:
  level:
    com.sphp: INFO
    # MyBatis Mapper SQL 日志，日常 WARN，调试时改为 DEBUG
    com.sphp.admin.mapper: WARN
    com.sphp.user.mapper: WARN
    org.apache.ibatis: WARN
    org.mybatis: WARN
