server:
  port: ${dev.server.port}
  servlet:
    context-path: ${dev.server.servlet.context-path}

spring:
  application:
    name: ${dev.spring.application.name}
  profiles:
    # 启用开发环境配置，使下方占位符能够读取 dev 命名空间中的实际值。
    active: dev

  # ---- PostgreSQL ----
  datasource:
    driver-class-name: ${dev.spring.datasource.driver-class-name}
    type: ${dev.spring.datasource.type}
    username: ${dev.spring.datasource.username}
    password: ${dev.spring.datasource.password}
    url: ${dev.spring.datasource.url}
    hikari:
      connection-timeout: ${dev.spring.datasource.hikari.connection-timeout}
      idle-timeout: ${dev.spring.datasource.hikari.idle-timeout}
      max-lifetime: ${dev.spring.datasource.hikari.max-lifetime}
      maximum-pool-size: ${dev.spring.datasource.hikari.maximum-pool-size}
      minimum-idle: ${dev.spring.datasource.hikari.minimum-idle}
      pool-name: ${dev.spring.datasource.hikari.pool-name}

  # ---- Redis ----
  data:
    redis:
      host: ${dev.spring.data.redis.host}
      port: ${dev.spring.data.redis.port}
      password: ${dev.spring.data.redis.password}
      database: ${dev.spring.data.redis.database}
      timeout: ${dev.spring.data.redis.timeout}
      lettuce:
        pool:
          max-active: ${dev.spring.data.redis.lettuce.pool.max-active}
          max-idle: ${dev.spring.data.redis.lettuce.pool.max-idle}
          min-idle: ${dev.spring.data.redis.lettuce.pool.min-idle}

  # ---- RabbitMQ ----
  rabbitmq:
    host: ${dev.spring.rabbitmq.host}
    port: ${dev.spring.rabbitmq.port}
    username: ${dev.spring.rabbitmq.username}
    password: ${dev.spring.rabbitmq.password}
    virtual-host: ${dev.spring.rabbitmq.virtual-host}
    connection-timeout: ${dev.spring.rabbitmq.connection-timeout}
    dynamic: ${dev.spring.rabbitmq.dynamic}
    listener:
      simple:
        auto-startup: ${dev.spring.rabbitmq.listener.simple.auto-startup}
        acknowledge-mode: ${dev.spring.rabbitmq.listener.simple.acknowledge-mode}
        concurrency: ${dev.spring.rabbitmq.listener.simple.concurrency}
        max-concurrency: ${dev.spring.rabbitmq.listener.simple.max-concurrency}
      direct:
        auto-startup: ${dev.spring.rabbitmq.listener.direct.auto-startup}

# ---- MyBatis-Plus ----
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: ${dev.mybatis-plus.configuration.map-underscore-to-camel-case}
    log-impl: ${dev.mybatis-plus.configuration.log-impl}
  global-config:
    db-config:
      logic-delete-field: ${dev.mybatis-plus.global-config.db-config.logic-delete-field}
      logic-delete-value: ${dev.mybatis-plus.global-config.db-config.logic-delete-value}
      logic-not-delete-value: ${dev.mybatis-plus.global-config.db-config.logic-not-delete-value}

# ---- Sa-Token（B端认证：签发 JWT，Bearer 头鉴权） ----
sa-token:
  token-name: ${dev.sa-token.token-name}
  token-prefix: ${dev.sa-token.token-prefix}
  timeout: ${dev.sa-token.timeout}
  is-concurrent: ${dev.sa-token.is-concurrent}
  is-share: ${dev.sa-token.is-share}
  is-read-cookie: ${dev.sa-token.is-read-cookie}
  is-read-header: ${dev.sa-token.is-read-header}
  is-write-header: ${dev.sa-token.is-write-header}
  jwt-secret-key: ${dev.sa-token.jwt-secret-key}
  is-log: ${dev.sa-token.is-log}

sphp:
  cors:
    allowed-origins:
      - ${dev.sphp.cors.allowed-origins[0]}
      - ${dev.sphp.cors.allowed-origins[1]}
  jwt:
    patient:
      secret: ${dev.sphp.jwt.patient.secret}
      expiration: ${dev.sphp.jwt.patient.expiration}
    admin:
      secret: ${dev.sphp.jwt.admin.secret}
      expiration: ${dev.sphp.jwt.admin.expiration}
  registration:
    payment-timeout: ${dev.sphp.registration.payment-timeout}
